# Node.js
apps/web/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Wails source template; keep generated desktop build artifacts ignored.
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/windows/
apps/desktop/build/windows/*
!apps/desktop/build/windows/info.json
!apps/desktop/build/windows/installer/
apps/desktop/build/windows/installer/*
!apps/desktop/build/windows/installer/project.nsi

bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Docker
**/pgdata/
*.pid

# VS Code
.vscode/
.history/

# OS
.DS_Store
Thumbs.db

# Environment files
docker/.env

# Logs
*.log

apps/api/main
apps/api/tmp/
apps/api/.local-dev/

dev_license_public.pem
dev_license_private.pem
# Generated by Wails
apps/web/wailsjs/
apps/desktop/frontend/wailsjs/
apps/web/package.json.md5

# Playwright transient output; curated documentation screenshots are tracked in docs/screenshots.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Local application data and credentials must never enter source snapshots.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
.env
.env.local
.env.*.local
*.key
*.pem
.venv/
__pycache__/
